<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>LAD Courier USA</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lad_courier</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- 🛡️ REFUERZO V19.11: CONFIGURACIÓN DE URL SCHEME PARA STRIPE Y DEEP LINKS -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>ladcourier</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ladcourier</string>
			</array>
		</dict>
	</array>

	<!-- PERMISOS DE CÁMARA Y GALERÍA PARA LAD COURIER -->
	<key>NSCameraUsageDescription</key>
	<string>LAD usa tu cámara para escanear tickets de compra y fotos de evidencia para proteger tu entrega.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>LAD guarda copias de tus comprobantes de entrega en tu galería para tu respaldo legal.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>LAD detecta tus capturas de pantalla para auto-llenar tus órdenes de SmartShopper instantáneamente.</string>

	<!-- 🛡️ REFUERZO V19.11: PERMISOS DE UBICACIÓN Y BIOMETRÍA PARA IPHONE -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>LAD necesita tu ubicación para mostrarte órdenes cercanas y guiarte durante la entrega.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>LAD usa tu ubicación en segundo plano para asegurar que el cliente reciba actualizaciones en tiempo real de su paquete.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>LAD usa FaceID para validar tu identidad al inicio de cada jornada de trabajo, protegiendo tu cuenta de accesos no autorizados.</string>
	<!-- FIN DE PERMISOS -->

</dict>
</plist>
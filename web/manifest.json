{
    "name": "LAD Courier USA",
    "short_name": "LAD Courier",
    "start_url": "/app/index.html",
    "scope": "/app/",
    "display": "standalone",
    "background_color": "#000000",
    "theme_color": "#000000",
    "description": "LAD Courier USA - Tu plataforma soberana de mensajería y logística.",
    "orientation": "portrait-primary",
    "prefer_related_applications": false,
    "share_target": {
        "action": "/app/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "name",
            "text": "description",
            "url": "link",
            "files": [
                {
                    "name": "screenshot",
                    "accept": ["image/jpeg", "image/png", "image/webp"]
                }
            ]
        }
    },
    "icons": [
        {
            "src": "icons/Icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icons/Icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "icons/Icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/Icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}